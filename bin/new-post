#!/usr/bin/env bash

set -euo pipefail

usage() {
  cat <<'EOF'
Usage:
  ./bin/new-post "Post Title" optional-slug
  ./bin/new-post --draft "Draft Title" optional-slug
  ./bin/new-post --dry-run "Post Title" optional-slug

Examples:
  ./bin/new-post "GitHub Pages Blog Setup" github-pages-blog
  ./bin/new-post --draft "Jekyll Notes" jekyll-notes
EOF
}

draft_mode=false
dry_run=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --draft)
      draft_mode=true
      shift
      ;;
    --dry-run)
      dry_run=true
      shift
      ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      break
      ;;
  esac
done

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

title="$1"
shift || true
slug="${1:-}"

if [[ -z "$slug" ]]; then
  slug="$(printf '%s' "$title" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
fi

if [[ -z "$slug" ]]; then
  echo "Error: slug is required when the title cannot be converted safely."
  echo "Example: ./bin/new-post \"$title\" custom-slug"
  exit 1
fi

root_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
timestamp="$(TZ=Asia/Seoul date '+%Y-%m-%d %H:%M:%S %z')"
post_date="$(TZ=Asia/Seoul date '+%Y-%m-%d')"

if [[ "$draft_mode" == true ]]; then
  target_dir="$root_dir/_drafts"
  target_file="$target_dir/$slug.md"
else
  target_dir="$root_dir/_posts"
  target_file="$target_dir/$post_date-$slug.md"
fi

mkdir -p "$target_dir"

if [[ -e "$target_file" ]]; then
  echo "Error: file already exists: $target_file"
  exit 1
fi

content=$(cat <<EOF
---
title: "$title"
date: $timestamp
categories: [notes]
tags: []
# description: "한 줄 요약 (비우면 본문 첫 문단이 카드와 meta description에 쓰임)"
# image:
#   path: /assets/images/posts/$slug.png
#   alt: ""
# series: example-series
# series_order: 1
---

이 글을 한 줄로 소개하는 문단. (description을 비워두면 이 첫 문단이 카드 요약과 meta description에 쓰입니다.)

## TL;DR

1.
2.
3.

## 문제

- 무엇을 해결하려 했나?

## 접근

- 왜 이 방법을 골랐나?

## 결과

- 적용 후 무엇이 달라졌나?
EOF
)

if [[ "$dry_run" == true ]]; then
  echo "Target: $target_file"
  echo
  printf '%s\n' "$content"
  exit 0
fi

printf '%s\n' "$content" > "$target_file"
echo "Created: $target_file"

